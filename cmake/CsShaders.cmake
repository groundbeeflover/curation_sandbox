#
# cs_add_shaders(<target> <directory>)
#
# Compiles every <directory>/*.slang (found by glob, so a new shader needs no CMake edit) to
# SPIR-V 1.6 with slangc at build time, and embeds the SPIR-V in <target>, which then defines
# cs::gpu::embedded_shaders() (cs/gpu/pipeline.hpp). Shaders are never compiled at run time, and
# a shader that does not compile fails the build (ADR 0001).
#
# slangc writes each shader as a C++ array itself (-source-embed-style u32), into <stem>.spv.h in
# the build tree, with every [shader(...)] entry point of the file kept under its own name
# (-fvk-use-entrypoint-name). Warnings are errors. A generated embedded_shaders.cpp includes
# those headers and lists them in name order. slangc also writes a depfile, so a shader is
# compiled again when a module it imports changes.
#
# slangc is the imported executable slang::slangc, from vcpkg's shader-slang host port, whose
# version vcpkg.json pins (docs/dependencies.md); libs/gpu/CMakeLists.txt finds it.

function(cs_add_shaders target directory)
    if(NOT TARGET slang::slangc)
        message(FATAL_ERROR "cs_add_shaders(${target}): slang::slangc was not found; "
            "find_package(slang) first (libs/gpu/CMakeLists.txt)")
    endif()

    file(GLOB shaders CONFIGURE_DEPENDS "${directory}/*.slang")
    list(SORT shaders)
    set(out "${CMAKE_CURRENT_BINARY_DIR}/${target}_shaders")
    file(RELATIVE_PATH source "${PROJECT_SOURCE_DIR}" "${directory}")

    set(headers "")
    set(includes "")
    set(entries "")
    set(count 0)
    foreach(shader IN LISTS shaders)
        get_filename_component(stem "${shader}" NAME_WE)
        # The stem names a C++ variable and is looked up by name at run time.
        if(NOT stem MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR "cs_add_shaders(${target}): ${shader}: a shader's file name is "
                "snake_case (a-z, 0-9 and _, starting with a letter)")
        endif()
        set(header "${out}/${stem}.spv.h")
        set(array "cs_shader_${stem}")
        add_custom_command(
            OUTPUT "${header}"
            COMMAND slang::slangc "${shader}"
                -target spirv -profile spirv_1_6 -fvk-use-entrypoint-name
                -warnings-as-errors all
                -source-embed-style u32 -source-embed-name "${array}"
                -o "${header}" -depfile "${header}.d"
            DEPENDS "${shader}" slang::slangc
            DEPFILE "${header}.d"
            COMMENT "Compiling shader ${stem}.slang to SPIR-V"
            VERBATIM)
        list(APPEND headers "${header}")
        string(APPEND includes "#include \"${stem}.spv.h\"\n")
        string(APPEND entries
            "    EmbeddedShader{\"${stem}\", std::span<const std::uint32_t>(${array})},\n")
        math(EXPR count "${count} + 1")
    endforeach()

    # Rewritten only when its text changes, so an unchanged set of shaders recompiles nothing.
    file(CONFIGURE OUTPUT "${out}/embedded_shaders.cpp" CONTENT [=[
// SPDX-License-Identifier: Apache-2.0
// Generated by cmake/CsShaders.cmake from @source@/*.slang; do not edit.

#include <cs/gpu/pipeline.hpp>

#include <array>
#include <span>
#include <stddef.h> // slangc's headers use size_t and uint32_t unqualified
#include <stdint.h>

namespace {
@includes@} // namespace

namespace cs::gpu {

namespace {
constexpr std::array<EmbeddedShader, @count@> shaders{
@entries@};
} // namespace

std::span<const EmbeddedShader> embedded_shaders() {
    return shaders;
}

} // namespace cs::gpu
]=] @ONLY)

    target_sources(${target} PRIVATE "${out}/embedded_shaders.cpp" ${headers})
    target_include_directories(${target} PRIVATE "${out}")
endfunction()
