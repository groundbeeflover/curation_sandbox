{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "debug",
      "displayName": "Debug, with sanitizers",
      "description": "For writing code: slow, but catches memory bugs and undefined behaviour",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CS_SANITIZERS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "For rendering: fully optimised",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "profile",
      "displayName": "Optimised, with debug info",
      "description": "For profiling, and for debugging code that is too slow in a debug build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "app",
      "displayName": "Debug, with sanitizers and the Qt app",
      "description": "The debug preset plus the ui module and the desktop app (needs Qt 6)",
      "inherits": "debug",
      "cacheVariables": {
        "CS_BUILD_APP": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets",
      "description": "Clang with ASan, UBSan and libFuzzer: every libs/<module>/fuzz/*.cpp is a fuzz target; optimised, but asserts stay on",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "CS_SANITIZERS": "ON",
        "CS_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "app", "configurePreset": "app" },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "sanitized",
      "hidden": true,
      "inherits": "base",
      "environment": {
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tools/sanitizers/lsan.supp",
        "VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING": "1"
      }
    },
    { "name": "debug", "configurePreset": "debug", "inherits": "sanitized" },
    { "name": "release", "configurePreset": "release", "inherits": "base" },
    { "name": "profile", "configurePreset": "profile", "inherits": "base" },
    { "name": "app", "configurePreset": "app", "inherits": "sanitized" },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "inherits": "sanitized",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ]
}
