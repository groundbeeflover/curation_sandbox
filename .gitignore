# Build output (vcpkg installs the libraries into build/<preset>/vcpkg_installed/)
/build/
/out/

# Personal presets, for example one that sets VCPKG_ROOT
CMakeUserPresets.json

# Rendered images
/renders/

# Editor and tool files
.vscode/
.idea/
.cache/
compile_commands.json
*.swp
.DS_Store

# Claude Code: the project's settings, skills and subagents are committed, even where a global
# ignore file excludes .claude/; worktrees and personal overrides are not.
!.claude/
.claude/worktrees/
.claude/settings.local.json
