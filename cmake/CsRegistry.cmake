#
# cs_generate_registry(<module> <dir> [FUNCTION <name>] [PARAMETERS <type>...] [INCLUDES <header>...])
#
# A list that grows by adding a file: every libs/<module>/src/<dir>/<name>.cpp defines
#
#     void cs::<module>::register_<name>(<PARAMETERS>)
#
# and a generated source file, compiled into cs::<module>, declares each of them and defines
#
#     void cs::<module>::<FUNCTION>(<PARAMETERS>)
#
# which calls them all with its own arguments, in file name order. FUNCTION defaults to
# register_<dir>, with / in <dir> made _. So adding a UI feature or a file-format migration is
# one new file, never an edit to a shared list. The module declares FUNCTION in one of its own
# headers; INCLUDES are the headers the generated file includes (as #include <...>), so that the
# PARAMETERS types are declared and FUNCTION is checked against that declaration.
#
# An explicit call, rather than objects that register themselves when the program starts, because
# a static library drops object files that nothing refers to: a self-registering feature would
# silently vanish from the app.
#
# Call it after cs_add_module in libs/<module>/CMakeLists.txt:
#
#   cs_generate_registry(ui features PARAMETERS "MainWindow&" INCLUDES "features/feature.hpp")
#
# Only the directory's own *.cpp are registered, not those of its subdirectories, and each
# file's name must be a C++ identifier (snake_case.cpp). The directory is globbed with
# CONFIGURE_DEPENDS, so `cmake --build` notices a file added or removed and regenerates the list.

function(cs_generate_registry module dir)
    cmake_parse_arguments(PARSE_ARGV 2 arg "" "FUNCTION" "PARAMETERS;INCLUDES")
    set(where "cs_generate_registry(${module} ${dir})")
    if(arg_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "${where}: unknown arguments: ${arg_UNPARSED_ARGUMENTS}")
    endif()
    set(target cs_${module})
    if(NOT TARGET ${target})
        message(FATAL_ERROR "${where}: no module ${module}; call it after cs_add_module")
    endif()
    get_target_property(type ${target} TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY")
        message(FATAL_ERROR "${where}: module ${module} is header-only (no src/**/*.cpp), so "
            "there is no library to add the registry to")
    endif()
    if(IS_ABSOLUTE "${dir}" OR dir MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "${where}: <dir> is relative to libs/${module}/src/, inside it")
    endif()
    get_target_property(module_dir ${target} SOURCE_DIR)
    set(source_dir "${module_dir}/src/${dir}")
    if(NOT IS_DIRECTORY "${source_dir}")
        message(FATAL_ERROR "${where}: ${source_dir} is not a directory")
    endif()

    if(arg_FUNCTION)
        set(function ${arg_FUNCTION})
    else()
        string(REPLACE "/" "_" function "register_${dir}")
    endif()
    # Parameters are named p0, p1, ...; unnamed when nothing uses them, so that an empty registry
    # compiles without unused-parameter warnings.
    set(declared "")
    set(named "")
    set(arguments "")
    set(i 0)
    foreach(parameter IN LISTS arg_PARAMETERS)
        list(APPEND declared "${parameter}")
        list(APPEND named "${parameter} p${i}")
        list(APPEND arguments "p${i}")
        math(EXPR i "${i} + 1")
    endforeach()
    list(JOIN declared ", " declared)
    list(JOIN named ", " named)
    list(JOIN arguments ", " arguments)

    file(GLOB files CONFIGURE_DEPENDS "${source_dir}/*.cpp")
    list(SORT files)
    set(declarations "")
    set(calls "")
    foreach(file IN LISTS files)
        # NAME_WLE: only .cpp comes off, so that good.bye.cpp is refused rather than read as good.
        get_filename_component(name "${file}" NAME_WLE)
        if(NOT name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
            message(FATAL_ERROR "${where}: ${file} cannot name a registration function; "
                "rename it to a C++ identifier, such as snake_case.cpp")
        endif()
        string(APPEND declarations "void register_${name}(${named});\n")
        string(APPEND calls "    register_${name}(${arguments});\n")
    endforeach()
    set(includes "")
    foreach(include IN LISTS arg_INCLUDES)
        string(APPEND includes "#include <${include}>\n")
    endforeach()
    if(NOT files)
        set(named "${declared}")
    endif()

    get_target_property(binary_dir ${target} BINARY_DIR)
    set(output "${binary_dir}/registries/${function}.cpp")
    # file(CONFIGURE) rewrites the file only when its text changes, so an unchanged list
    # recompiles nothing.
    file(CONFIGURE OUTPUT "${output}" @ONLY CONTENT [=[
// SPDX-License-Identifier: Apache-2.0
// Generated by cs_generate_registry (cmake/CsRegistry.cmake) from
// libs/@module@/src/@dir@/. Do not edit: add or remove a file there instead.

@includes@
namespace cs::@module@ {

@declarations@
void @function@(@named@) {
@calls@}

} // namespace cs::@module@
]=])
    target_sources(${target} PRIVATE "${output}")
endfunction()
